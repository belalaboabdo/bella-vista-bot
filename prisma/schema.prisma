generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Restaurant lookup
model Restaurant {
  id            Int            @id @default(autoincrement())
  name          String
  phone         String?
  address       String?
  opensAt       String         @default("11:00") // HH:MM 24h format
  closesAt      String         @default("23:00") // HH:MM 24h format
  conversations Conversation[]
  tables        RestaurantTable[]
  guests        Guest[]
  createdAt     DateTime       @default(now())
}

// Restaurant domain models
model Guest {
  id            Int            @id @default(autoincrement())
  firstName     String
  lastName      String
  phone         String
  email         String
  dietary       String?
  notes         String?
  restaurantId  Int            @default(1)
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id])
  reservations  Reservation[]
  conversations Conversation[]
}

model RestaurantTable {
  id           Int           @id @default(autoincrement())
  capacity     Int
  location     String
  restaurantId Int           @default(1)
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id])
  reservations Reservation[]
}

model Reservation {
  id        Int              @id @default(autoincrement())
  guestId   Int
  tableId   Int
  partySize Int
  date      String
  time      String
  status    String           @default("confirmed")
  notes     String?
  guest     Guest            @relation(fields: [guestId], references: [id])
  table     RestaurantTable  @relation(fields: [tableId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Conversation {
  id           Int      @id @default(autoincrement())
  guestId      Int
  restaurantId Int      @default(1)
  messages     Json     // Full Anthropic-format message history
  summary      String?  // Auto-generated conversation summary
  actions      Json?    // Array of actions taken during conversation
  guest        Guest      @relation(fields: [guestId], references: [id])
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
